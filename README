<body>

    <!-- Link de salto para leitores de tela e navegação por teclado -->
    <a href="#conteudo-principal" style="position: absolute; left: -10000px;">Ir para o conteúdo principal</a>

    <header>
        <h1>Visão & Acessibilidade</h1>
        <div class="controls" role="toolbar" aria-label="Controles de Acessibilidade">
            <button id="btn-alt-contraste" aria-label="Alternar alto contraste">Alto Contraste</button>
            <button id="btn-aumentar" aria-label="Aumentar tamanho do texto">A+</button>
            <button id="btn-diminuir" aria-label="Diminuir tamanho do texto">A-</button>
        </div>
    </header>

    <main id="conteudo-principal">
        <article>
            <h2>Demonstração de Recursos Práticos</h2>
            <p class="texto-acessivel">Este projeto foi desenvolvido em HTML, CSS e JavaScript para demonstrar recursos essenciais de acessibilidade digital na web. Teste os botões acima utilizando o mouse ou a tecla Tab do seu teclado.</p>
        </article>
    </main>

    <script>
        // Funcionalidade 1: Alto Contraste
        const btnContraste = document.getElementById('btn-alt-contraste');
        btnContraste.addEventListener('click', () => {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            if (currentTheme === 'dark') {
                document.documentElement.removeAttribute('data-theme');
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        });

        // Funcionalidade 2: Controle de Fonte (A+ / A-)
        let fontSizeAtual = 100; // Representa 100%
        const limiteMax = 150;
        const limiteMin = 80;
        
        const texto = document.querySelector('.texto-acessivel');

        document.getElementById('btn-aumentar').addEventListener('click', () => {
            if (fontSizeAtual < limiteMax) {
                fontSizeAtual += 10;
                texto.style.fontSize = `${fontSizeAtual}%`;
            }
        });

        document.getElementById('btn-diminuir').addEventListener('click', () => {
            if (fontSizeAtual > limiteMin) {
                fontSizeAtual -= 10;
                texto.style.fontSize = `${fontSizeAtual}%`;
            }
        });
    </script>
</body>
</html>
