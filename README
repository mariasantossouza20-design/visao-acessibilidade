    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visão & Acessibilidade</title>
    <style>
        /* Variáveis CSS para facilitar o Alto Contraste */
        :root {
            --bg-color: #ffffff;
            --text-color: #222223;
            --header-bg: #f0f0f4;
            --btn-bg: #0056b3;
            --btn-text: #ffffff;
        }

        [data-theme="dark"] {
            --bg-color: #000000;
            --text-color: #ffff00; /* Amarelo no preto garante altíssimo contraste */
            --header-bg: #1a1a1a;
            --btn-bg: #ffff00;
            --btn-text: #000000;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            line-height: 1.6;
            transition: background 0.3s, color 0.3s;
        }

        header {
            background-color: var(--header-bg);
            padding: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--text-color);
        }

        .controls button {
            background-color: var(--btn-bg);
            color: var(--btn-text);
            border: 2px solid var(--text-color);
            padding: 0.5rem 1rem;
            margin-left: 0.5rem;
            cursor: pointer;
            font-weight: bold;
            font-size: 1rem;
        }

        main {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 1rem;
        }
    </style>
